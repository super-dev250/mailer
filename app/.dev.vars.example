# Copy to .dev.vars to run the web app locally with `npm run dev`.
# This is the secret you type on the sign-in screen. Use at least 16 characters.
APP_SECRET=local-dev-secret-change-me

# Optional: lets the GitHub contacts page search commits. See the README.
# GH_API_TOKEN=

# Optional: lets the Slack contacts page search messages. See the README.
# SLACK_API_TOKEN=
