# Copy to .env to run the mailer from your own computer with `npm run runner`.
# On GitHub these same names are repository secrets instead.
APP_URL=http://localhost:8787
APP_SECRET=local-dev-secret-change-me
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional: send through Brevo instead of Gmail's own SMTP (Gmail above still handles replies/bounces).
# BREVO_SMTP_LOGIN=you@example.com
# BREVO_SMTP_KEY=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: more than one Gmail account — replaces GMAIL_USER/GMAIL_APP_PASSWORD above.
# Each entry can set its own brevo_login/brevo_key, or omit them to fall back to
# BREVO_SMTP_LOGIN/BREVO_SMTP_KEY above (or to that mailbox's own Gmail SMTP if neither is set).
# GMAIL_ACCOUNTS=[{"user":"you@gmail.com","app_password":"aaaa bbbb cccc dddd","brevo_login":"xxxxxx001@smtp-brevo.com","brevo_key":"xsmtpsib-aaaa..."}]
